vec3 WindOffset(vec3 worldPos, float bend, float height) {
	float t       = timeInfo.x;
	float gust    = sin(t * 0.9 + dot(worldPos.xz, vec2(0.011, 0.007))) * 0.6 + 0.4;   // a wave moving over the land
	float flutter = sin(t * 2.3 + worldPos.x * 0.7 + worldPos.z * 0.5) * 0.15;
	float amount  = (gust + flutter) * bend * bend * height * 0.05;
	return vec3(amount * 0.8, 0.0, amount * 0.6);
}
