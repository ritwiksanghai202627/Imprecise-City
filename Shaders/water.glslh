// Water shading shared by the sea and the distant sea painted in the sky.
// Needs support.glslh included first.

// Island height map (terrain height in metres, 512 x 512 over x,z in [-SHORE_EXTENT, +SHORE_EXTENT]),
// bound by the renderer to unit 6 for the whole main pass. Water depth = minus the terrain height.
layout(binding = 6) uniform sampler2D shoreMap;
const float SHORE_EXTENT = 1024.0;   // must match Terrain::GetHalfExtent()

// > 0 under water, about 0 at the shoreline. Far outside the island the clamped border reads as deep.
float WaterDepth(vec2 xz) {
	return -texture(shoreMap, xz / (2.0 * SHORE_EXTENT) + 0.5).r;
}

// 1 while a wave is resolved, 0 once a pixel covers about half its wavelength.
float WaveFade(float wavelength, float footprint) {
	return 1.0 - smoothstep(wavelength * 0.22, wavelength * 0.55, footprint);
}

// Analytic normal from nine directional wave trains: sum their slopes, no textures or finite
// differences. 'footprint' is the world-space size of a pixel (max of fwidth(worldPos.xz));
// fading by it handles both distance and viewing angle. The trains use incommensurate
// wavelengths and a noise warp so the crests never settle into a repeating lattice. The three
// long swells keep the surface from going mirror-flat in the mid distance.
vec3 WaterNormal(vec2 xz, float time, float footprint) {
	vec2 d0 = normalize(vec2( 0.97,  0.26));
	vec2 d1 = normalize(vec2( 0.21,  0.98));
	vec2 d2 = normalize(vec2(-0.63,  0.78));
	vec2 d3 = normalize(vec2(-0.94, -0.34));
	vec2 d4 = normalize(vec2(-0.34, -0.94));
	vec2 d5 = normalize(vec2( 0.68, -0.73));
	vec2 d6 = normalize(vec2( 0.42,  0.91));
	vec2 d7 = normalize(vec2(-0.88,  0.47));
	vec2 d8 = normalize(vec2( 0.76, -0.65));

	const float k0 = 6.2831853 / 23.0;
	const float k1 = 6.2831853 / 11.3;
	const float k2 = 6.2831853 /  6.1;
	const float k3 = 6.2831853 /  3.7;
	const float k4 = 6.2831853 /  2.3;
	const float k5 = 6.2831853 /  1.4;
	const float k6 = 6.2831853 / 137.0;
	const float k7 = 6.2831853 /  61.0;
	const float k8 = 6.2831853 /  37.0;

	float warp = ValueNoise(xz * 0.03) * 4.0;

	// Skip trains whose fade has reached zero.
	vec2 slope = vec2(0.0);
	float f0 = WaveFade( 23.0, footprint);
	if (f0 > 0.001) slope += d0 * (0.095 * f0) * cos(dot(d0, xz) * k0 - time * 2.0 + warp);
	float f1 = WaveFade( 11.3, footprint);
	if (f1 > 0.001) slope += d1 * (0.070 * f1) * cos(dot(d1, xz) * k1 - time * 2.6 + warp * 1.6);
	float f2 = WaveFade(  6.1, footprint);
	if (f2 > 0.001) slope += d2 * (0.050 * f2) * cos(dot(d2, xz) * k2 - time * 3.3 + warp * 2.1);
	float f3 = WaveFade(  3.7, footprint);
	if (f3 > 0.001) slope += d3 * (0.035 * f3) * cos(dot(d3, xz) * k3 - time * 4.1 + warp * 2.7);
	float f4 = WaveFade(  2.3, footprint);
	if (f4 > 0.001) slope += d4 * (0.024 * f4) * cos(dot(d4, xz) * k4 - time * 5.2 + warp * 3.3);
	float f5 = WaveFade(  1.4, footprint);
	if (f5 > 0.001) slope += d5 * (0.016 * f5) * cos(dot(d5, xz) * k5 - time * 6.4 + warp * 3.9);

	// Long swells survive a much larger footprint, keeping some shape in the mid/far sea.
	float f6 = WaveFade(137.0, footprint);
	if (f6 > 0.001) slope += d6 * (0.020 * f6) * cos(dot(d6, xz) * k6 - time * 1.05 + warp * 0.6);
	float f7 = WaveFade( 61.0, footprint);
	if (f7 > 0.001) slope += d7 * (0.026 * f7) * cos(dot(d7, xz) * k7 - time * 1.35 + warp * 0.8);
	float f8 = WaveFade( 37.0, footprint);
	if (f8 > 0.001) slope += d8 * (0.018 * f8) * cos(dot(d8, xz) * k8 - time * 1.70 + warp * 1.0);

	return normalize(vec3(-slope.x, 1.0, -slope.y));
}

// Sparse glints riding on the wave slopes. The early-out avoids the noise cost on distant water.
float WaterGlitter(vec2 xz, float time, float footprint) {
	if (footprint > 1.6) {
		return 0.0;
	}
	vec2 p = xz * 2.3 + vec2(time * 1.7, -time * 1.1);
	float n = ValueNoise(p) * ValueNoise(p * 2.1 + 7.3);
	return smoothstep(0.55, 0.75, n) * (1.0 - smoothstep(0.45, 1.60, footprint));
}

// Full surface colour, shared by the sea quad and the sea painted in the sky.
// Needs lighting.glslh (ApplyFog) included first. envMap is bound to unit 5.
vec3 ShadeWater(vec3 worldPos, vec3 V, float footprint, float dist, samplerCube envMap) {
	// Winter (timeInfo.z = snow cover): the sea freezes over. Waves flatten, then the surface becomes ice.
	float ice = saturate(timeInfo.z);
	vec3  N   = (ice > 0.95) ? vec3(0.0, 1.0, 0.0) : WaterNormal(worldPos.xz, timeInfo.x, footprint);
	N = normalize(lerp(N, vec3(0.0, 1.0, 0.0), ice * 0.9));

	float fresnel = pow(1.0 - saturate(dot(N, V)), 5.0);
	vec3  deep    = vec3(0.02, 0.12, 0.22);
	vec3  R       = reflect(-V, N);
	float mip     = 1.0 + 2.0 * saturate(dist / 1500.0);
	vec3  sky     = textureLod(envMap, R, mip).rgb;
	vec3  colour  = lerp(deep, sky, saturate(0.08 + 0.92 * fresnel));

	if (ice > 0.01) {
		// Ice: pale blue-white, with slow patches and crack lines.
		float patchN = ValueNoise(worldPos.xz * 0.04);
		float crackN = abs(ValueNoise(worldPos.xz * 0.22 + 9.0) - 0.5);
		vec3  iceCol = lerp(vec3(0.52, 0.68, 0.80), vec3(0.86, 0.92, 0.97), smoothstep(0.30, 0.75, patchN));
		iceCol      *= 0.80 + 0.35 * smoothstep(0.0, 0.03, crackN);   // darker thin cracks
		vec3  lit    = fogColour.rgb * 0.55 + sunColour.rgb * sunDir.w * saturate(sunDir.y) * 0.60;
		colour = lerp(colour, iceCol * lit * 1.4 + sky * fresnel * 0.25, ice * 0.92);
	}

	// Tight sun glint on top of the blurred cube-map disc.
	float sun = saturate(dot(R, sunDir.xyz));
	if (sun > 0.10) {
		float glitter = WaterGlitter(worldPos.xz, timeInfo.x, footprint);
		float glint   = pow(sun, 120.0) * 0.25 + pow(sun, 1200.0) * 4.0 * (0.35 + 0.9 * glitter);
		colour += sunColour.rgb * sunDir.w * glint * (1.0 - 0.8 * ice);
	}

	// Turquoise shallows and foam on the water side of the beach, near the camera only.
	if (dist < 1800.0) {
		float depth = WaterDepth(worldPos.xz);
		if (depth < 9.0) {
		float day   = saturate(sunDir.w);

		float shallow = 1.0 - smoothstep(0.4, 9.0, depth);
		colour = lerp(colour, vec3(0.10, 0.42, 0.46) * (0.25 + 0.75 * day), shallow * 0.5 * (1.0 - fresnel));

		// Foam bands travel towards the beach, broken up by noise.
		float warp  = ValueNoise(worldPos.xz * 0.08) * 6.0;
		float wave  = 0.5 + 0.5 * sin(depth * 2.2 - timeInfo.x * 1.3 + warp);
		float band  = 1.0 - smoothstep(0.0, 3.4, depth + (wave - 0.5) * 1.0);
		float edge  = 1.0 - smoothstep(0.0, 0.7, depth);   // a solid line right at the waterline
		float lace  = ValueNoise(worldPos.xz * 1.3 + vec2(timeInfo.x * 0.15, 0.0))
		            * ValueNoise(worldPos.xz * 3.1 - vec2(0.0, timeInfo.x * 0.10));
		// The lace fades once a pixel is wider than it; the thin waterline survives much further.
		float foam  = band * smoothstep(0.10, 0.36, lace + band * 0.35) * (1.0 - smoothstep(0.5, 2.5, footprint))
		            + edge * 0.8 * (1.0 - smoothstep(2.0, 8.0, footprint));
		foam = saturate(foam) * (1.0 - ice);   // the ice covers the surf

		vec3 foamColour = vec3(0.93, 0.96, 0.98) * (fogColour.rgb * 0.45 + sunColour.rgb * sunDir.w * 0.7);
		colour = lerp(colour, foamColour, foam * 0.85);
		}
	}

	// Thinner haze than the terrain keeps the distant sea readable.
	return ApplyFog(colour, dist, 0.5);
}
