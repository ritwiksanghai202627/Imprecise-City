// Lighting, shadow and fog helpers.
// Needs frame.glslh and support.glslh to be included before this file.

// Two cascaded shadow maps, one layer each of a depth texture array bound by the renderer.
// Layer 0 (near cascade) is a small box right around the viewer: very sharp shadows close up.
// Layer 1 (far cascade) is the big box that follows the camera, as the single map used to be.
layout(binding = 4) uniform sampler2DArrayShadow shadowMap;

// 4-tap percentage-closer filtering in one cascade. Each hardware depth compare already blends a
// 2x2 block of texels, so four taps placed 0.75 texel off-centre cover a soft ~4x4 footprint.
float CascadeLookup(float layer, vec3 uvz, float bias) {
	if (uvz.z > 1.0) {
		return 1.0;
	}
	float lit = 0.0;
	const float o = 0.75 * shadowParams.x;
	lit += texture(shadowMap, vec4(uvz.xy + vec2(-o, -o), layer, uvz.z - bias));
	lit += texture(shadowMap, vec4(uvz.xy + vec2( o, -o), layer, uvz.z - bias));
	lit += texture(shadowMap, vec4(uvz.xy + vec2(-o,  o), layer, uvz.z - bias));
	lit += texture(shadowMap, vec4(uvz.xy + vec2( o,  o), layer, uvz.z - bias));
	return lit * 0.25;
}

// How close a point is to the edge of a cascade: 0 in the middle, 1 at the border of the map.
float CascadeEdge(vec3 uvz) {
	vec2 fromCentre = abs(uvz.xy - 0.5) * 2.0;
	return max(fromCentre.x, fromCentre.y);
}

// 1.0 = fully lit, 0.0 = fully in shadow. N must be a unit vector.
float ShadowFactor(vec3 worldPos, vec3 N) {
	if (shadowParams.w < 0.5) {
		return 1.0;
	}

	// Surfaces facing away from the sun get no direct light anyway, so skip the shadow lookups.
	if (dot(N, sunDir.xyz) <= 0.0) {
		return 1.0;
	}

	// Normal offset: nudge the lookup point along the surface normal. This removes the
	// self-shadowing stripes ("acne") on slopes better than a large depth bias would. The offset
	// grows on surfaces that face away from the sun (grazing angles), where acne is worst, and is
	// sized per cascade (a texel of the near cascade is much smaller).
	float ndl   = saturate(dot(N, sunDir.xyz));
	float grow  = 1.0 + 2.0 * (1.0 - ndl);

	// Near cascade first: orthographic, so w is 1 and clip space maps -1..1 straight to 0..1.
	vec4 clip0 = shadowViewProj * vec4(worldPos + N * (shadowCascade.x * grow), 1.0);
	vec3 uvz0  = clip0.xyz * 0.5 + 0.5;
	float edge0 = CascadeEdge(uvz0);
	if (edge0 < 0.8) {
		return CascadeLookup(0.0, uvz0, shadowCascade.y);   // well inside the near map: one cascade is enough
	}

	// Near the border of the near cascade (or outside it): use the far cascade, blended across the seam.
	vec4 clip1 = shadowViewProj2 * vec4(worldPos + N * (shadowParams.z * grow), 1.0);
	vec3 uvz1  = clip1.xyz * 0.5 + 0.5;
	float farLit = CascadeLookup(1.0, uvz1, shadowParams.y);

	// Fade out near the edge of the far map instead of showing a hard line where shadows stop.
	farLit = lerp(farLit, 1.0, smoothstep(0.85, 1.0, CascadeEdge(uvz1)));

	if (edge0 >= 1.0) {
		return farLit;
	}
	float nearLit = CascadeLookup(0.0, uvz0, shadowCascade.y);
	return lerp(nearLit, farLit, smoothstep(0.8, 1.0, edge0));
}

// One directional light (the sun) plus a cheap sky/ground ambient term.
// 'shadow' scales the sun's contribution only; ambient light is never shadowed.
vec3 ApplyDirectional(vec3 albedo, vec3 N, float shadow) {
	float ndl           = saturate(dot(N, sunDir.xyz));
	vec3  skyAmbient    = fogColour.rgb * 0.45;
	vec3  groundAmbient = vec3(0.12, 0.11, 0.10) * environment.w;   // darker ground bounce at night
	vec3  ambient       = lerp(groundAmbient, skyAmbient, N.y * 0.5 + 0.5)
	                    + vec3(0.02, 0.025, 0.05) * environment.x;    // faint blue "moonlit sky" floor so night is never pure black
	return albedo * (ambient + sunColour.rgb * sunDir.w * ndl * shadow);
}

// Local lights: street lamps (point) and car headlights (spot). Counts come from the frame UBO,
// so by day (no lights on) the loops do nothing. Cheap falloff: linear fade squared, zero at the radius.
// Beyond 70 m from the camera the lights are skipped. A lamp's own radius is only ~45 m, so a surface
// further out than that receives nothing anyway; culling here removes the loop from most night pixels
// (distant lamps are simply not rendered, which is the accepted trade for frame rate).
const float LIGHT_CULL_DISTANCE = 70.0;

vec3 ApplyPointLights(vec3 albedo, vec3 N, vec3 worldPos) {
	vec3 sum = vec3(0.0);
	int pointCount = int(environment.y);
	for (int i = 0; i < pointCount; ++i) {
		vec3  toLight = pointLights[i].posRadius.xyz - worldPos;
		float range   = pointLights[i].posRadius.w;
		float d2      = dot(toLight, toLight);
		if (d2 > range * range) {
			continue;   // out of range: skip the sqrt and the divide below
		}
		float dist    = sqrt(d2);
		float falloff = 1.0 - dist / range;
		sum += pointLights[i].colour.rgb * (saturate(dot(N, toLight / dist)) * falloff * falloff);
	}
	return albedo * sum;
}

vec3 ApplySpotLights(vec3 albedo, vec3 N, vec3 worldPos) {
	vec3 sum = vec3(0.0);
	int spotCount = int(environment.z);
	for (int i = 0; i < spotCount; ++i) {
		vec3  toLight = spotLights[i].posRange.xyz - worldPos;
		float dist    = max(length(toLight), 0.001);
		vec3  L       = toLight / dist;
		float range2  = spotLights[i].posRange.w * spotLights[i].posRange.w;
		if (dot(toLight, toLight) > range2) {
			continue;   // out of range: skip the cone maths
		}
		// 1 inside the inner cone, fading to 0 at the outer cone.
		float cone    = smoothstep(spotLights[i].colourCosOuter.w, spotLights[i].dirCosInner.w, dot(-L, spotLights[i].dirCosInner.xyz));
		float falloff = saturate(1.0 - dist / spotLights[i].posRange.w);
		sum += spotLights[i].colourCosOuter.rgb * (saturate(dot(N, L)) * cone * falloff * falloff);
	}
	return albedo * sum;
}

vec3 ApplyLights(vec3 albedo, vec3 N, vec3 worldPos) {
	if (environment.y + environment.z < 0.5 || length(worldPos - cameraPos.xyz) > LIGHT_CULL_DISTANCE) {
		return vec3(0.0);
	}
	return ApplyPointLights(albedo, N, worldPos) + ApplySpotLights(albedo, N, worldPos);
}

// Everything that lights a surface: the sun (with shadows), ambient, and the local lights.
vec3 ApplyLighting(vec3 albedo, vec3 N, vec3 worldPos, float shadow) {
	return ApplyDirectional(albedo, N, shadow) + ApplyLights(albedo, N, worldPos);
}

// Exponential-squared fog: clear nearby, fades smoothly into the sky colour.
// The scale lets a surface use thinner haze (water uses ~0.5) without duplicating this maths.
vec3 ApplyFog(vec3 colour, float dist, float densityScale) {
	float x = dist * fogColour.w * densityScale;
	float f = 1.0 - exp(-x * x);
	return lerp(colour, fogColour.rgb, saturate(f));
}
vec3 ApplyFog(vec3 colour, float dist) { return ApplyFog(colour, dist, 1.0); }
