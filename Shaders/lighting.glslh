// Lighting, shadow and fog helpers.
// Needs frame.glslh and support.glslh to be included before this file.

layout(binding = 4) uniform sampler2DShadow shadowMap;   // the sun's depth map, bound by the renderer

// 1.0 = fully lit, 0.0 = fully in shadow. N must be a unit vector.
float ShadowFactor(vec3 worldPos, vec3 N) {
	if (shadowParams.w < 0.5) {
		return 1.0;
	}

	// Normal offset: nudge the lookup point along the surface normal. This removes the
	// self-shadowing stripes ("acne") on slopes better than a large depth bias would.
	// Surfaces facing away from the sun get no direct light anyway, so skip the shadow lookups.
	if (dot(N, sunDir.xyz) <= 0.0) {
		return 1.0;
	}

	// The offset grows on surfaces that face away from the sun (grazing angles), where acne is worst.
	float ndl    = saturate(dot(N, sunDir.xyz));
	float offset = shadowParams.z * (1.0 + 2.0 * (1.0 - ndl));
	vec4 clip = shadowViewProj * vec4(worldPos + N * offset, 1.0);
	vec3 uvz  = clip.xyz / clip.w * 0.5 + 0.5;   // orthographic, so w is 1; maps -1..1 to 0..1

	if (uvz.z > 1.0) {
		return 1.0;
	}

	// 4-tap percentage-closer filtering. Each hardware depth compare already blends a 2x2 block
	// of texels, so four taps placed 0.75 texel off-centre cover a soft ~4x4 footprint
	// (the earlier 3x3 loop used nine taps for a similar softness).
	float lit = 0.0;
	const float o = 0.75 * shadowParams.x;
	lit += texture(shadowMap, vec3(uvz.xy + vec2(-o, -o), uvz.z - shadowParams.y));
	lit += texture(shadowMap, vec3(uvz.xy + vec2( o, -o), uvz.z - shadowParams.y));
	lit += texture(shadowMap, vec3(uvz.xy + vec2(-o,  o), uvz.z - shadowParams.y));
	lit += texture(shadowMap, vec3(uvz.xy + vec2( o,  o), uvz.z - shadowParams.y));
	lit *= 0.25;

	// Fade out near the edge of the map instead of showing a hard line where shadows stop.
	vec2  fromCentre = abs(uvz.xy - 0.5) * 2.0;
	float fade       = smoothstep(0.85, 1.0, max(fromCentre.x, fromCentre.y));
	return lerp(lit, 1.0, fade);
}

// One directional light (the sun) plus a cheap sky/ground ambient term.
// 'shadow' scales the sun's contribution only; ambient light is never shadowed.
vec3 ApplyDirectional(vec3 albedo, vec3 N, float shadow) {
	float ndl           = saturate(dot(N, sunDir.xyz));
	vec3  skyAmbient    = fogColour.rgb * 0.45;
	vec3  groundAmbient = vec3(0.12, 0.11, 0.10);
	vec3  ambient       = lerp(groundAmbient, skyAmbient, N.y * 0.5 + 0.5);
	return albedo * (ambient + sunColour.rgb * sunDir.w * ndl * shadow);
}

// Exponential-squared fog: clear nearby, fades smoothly into the sky colour.
vec3 ApplyFog(vec3 colour, float dist) {
	float x = dist * fogColour.w;
	float f = 1.0 - exp(-x * x);
	return lerp(colour, fogColour.rgb, saturate(f));
}
