// One analytic sky, used twice: drawn behind the scene (skyFragment) and baked into the
// environment cube map that shiny objects reflect (bakeSkyFragment). Using the same function
// guarantees the reflections match what you see in the sky.
// Needs frame.glslh and support.glslh included first.

uniform vec3 zenithColour;   // sky colour straight up; the horizon colour is the fog colour

// Procedural clouds. Project the view direction onto a flat cloud deck, then evaluate four
// octaves of value noise. Returns rgb + coverage so SkyColour can composite them over the sun.
// Only sampled above the horizon, and faded out near it to hide the stretched, aliasing-prone
// band where the projection compresses to infinity.
vec4 CloudLayer(vec3 d) {
	float above = smoothstep(0.005, 0.06, d.y);
	if (above <= 0.0) {
		return vec4(0.0);
	}

	// d.y + 0.35 keeps the projection finite at the zenith (a pure d.xz / d.y pinches badly).
	vec2 p = d.xz / (d.y + 0.35) * 1.6;
	p += vec2(0.006, 0.0025) * timeInfo.x;   // slow drift

	float n   = 0.0;
	float amp = 0.5;
	for (int i = 0; i < 4; ++i) {
		n += amp * ValueNoise(p);
		p = mat2(0.80, -0.60, 0.60, 0.80) * p * 2.07 + vec2(13.7, 7.3);   // rotate, so octaves do not line up
		amp *= 0.5;
	}

	float cover = smoothstep(0.50, 0.62, n);
	if (cover <= 0.0) {
		return vec4(0.0);
	}

	// Cheap directional lighting: the side towards the sun is bright, the rest is shaded by the
	// zenith colour. The wide term keeps clouds readable at dusk.
	float sunAmount = saturate(dot(d, sunDir.xyz) * 0.5 + 0.5);
	vec3  lit   = lerp(fogColour.rgb, vec3(1.05, 1.03, 0.99), 0.65) * (0.55 + 0.55 * sunAmount);
	vec3  shade = lerp(zenithColour, fogColour.rgb, 0.30) * 0.85;
	vec3  cloud = lerp(shade, lit, smoothstep(0.38, 0.72, n));

	// Silver lining towards the sun; at night this is the moon, so it stays subtle.
	cloud += sunColour.rgb * sunDir.w * pow(saturate(dot(d, sunDir.xyz)), 24.0) * 0.45;

	// Clouds are silhouettes at night, not white.
	cloud *= lerp(1.0, 0.12, environment.x);
	return vec4(cloud, cover * above);
}

// Cloud shadows on the ground. Project the world position along the sun onto a flat deck and
// reuse the same value noise, so the shadows drift with the clouds. Two octaves are plenty: the
// edges are soft anyway, and this runs for every ground pixel.
// Cloud shadows on the ground. Project the world position along the sun onto a flat deck and
// reuse the same value noise, so the shadows drift with the clouds. One octave: cloud shadows are
// soft blobs, and this runs for every ground pixel (two octaves cost 2.4 ms here).
float CloudShadow(vec3 worldPos) {
	if (sunDir.y < 0.05) {
		return 1.0;   // sun below the horizon: nothing casts
	}

	const float deckHeight = 620.0;
	vec2 p = worldPos.xz + sunDir.xz * ((deckHeight - worldPos.y) / sunDir.y);
	p = p * 0.0035 + vec2(0.006, 0.0025) * timeInfo.x;   // same drift as CloudLayer

	float n = ValueNoise(p);
	return 1.0 - 0.55 * smoothstep(0.50, 0.64, n);
}

// Stars: a hash grid on the cube-projected direction. Only at night, fading out near the horizon,
// and drawn before the clouds so clouds pass in front of them.
vec3 StarField(vec3 d) {
	if (environment.x <= 0.01 || d.y <= 0.0) {
		return vec3(0.0);
	}

	vec3 a  = abs(d);
	vec2 uv = (a.x > a.z) ? vec2(d.z, d.y) / a.x : vec2(d.x, d.y) / a.z;
	vec2 g  = uv * 55.0;
	vec2 id = floor(g);
	vec2 f  = fract(g) - 0.5;

	float h = Hash21(id);
	if (h < 0.90) {
		return vec3(0.0);   // most cells are empty: a sparse sky
	}

	float twinkle = 0.65 + 0.35 * sin(timeInfo.x * 2.5 + h * 60.0);
	float star    = (1.0 - smoothstep(0.0, 0.16, length(f))) * twinkle;
	float bright  = mix(0.35, 1.0, smoothstep(0.90, 0.995, h));
	return vec3(star * bright) * saturate(d.y * 6.0) * environment.x * 1.4;
}

// groundAmount: 1 for the environment map (reflections see a dim ground below the horizon),
// 0 for the visible sky, where "below the horizon" must match the fogged sea, so it stays fog colour.
vec3 SkyColour(vec3 d, float groundAmount) {
	vec3  horizon = fogColour.rgb;
	float up      = saturate(d.y);
	vec3  col     = lerp(horizon, zenithColour, pow(up, 0.45));

	// Below the horizon there is no sky: a dim ground colour (only ever visible in reflections).
	col = lerp(col, vec3(0.16, 0.19, 0.13), saturate(-d.y * 6.0) * groundAmount);

	// Sun: a small bright disc plus a wide soft glow.
	float s = saturate(dot(d, sunDir.xyz));
	col += sunColour.rgb * sunDir.w * (0.30 * pow(s, 8.0) + 10.0 * pow(s, 2000.0));

	// At night the "sun" is the moon: give it a crisp disc and let the stars come out.
	col += vec3(0.85, 0.90, 1.00) * smoothstep(0.9994, 0.9997, s) * environment.x * 1.2;
	col += StarField(d);

	// Clouds sit in front of the sun, so they composite over the disc and glow.
	vec4 cloud = CloudLayer(d);
	col = lerp(col, cloud.rgb, cloud.a);
	return col;
}
